# .env del droplet. make push-data lo copia a web/.env si no existe;
# rellena los huecos y ejecuta en el droplet: make server-update
APP_NAME="Fuji Recipes"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fuji.tudominio.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=sqlite

# 30 días: el enlace de acceso te deja dentro un mes en cada navegador
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync

# Correo del enlace de acceso. DigitalOcean bloquea los puertos SMTP 25, 465
# y 587, así que usa un proveedor que acepte el 2525 (Brevo, Mailgun,
# Postmark, SendGrid…). Ejemplo con Brevo (gratis hasta 300 correos al día):
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Fuji Recipes"

# Único correo que puede pedir el enlace de acceso
FUJI_LOGIN_EMAIL=

FXW_SOURCE_DB=/home/fuji/fuji-recipes/fujixweekly.db
FXW_DEFAULT_CAMERA="X-T30 III"
FXW_DEFAULT_SENSOR=x-trans-v
